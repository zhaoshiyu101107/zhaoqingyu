# ============================================================
# 昭情雨 多平台机器人 环境变量示例
# 复制为 .env 后按需修改:cp .env.example .env
# ============================================================

# opencode 模型 API Key(可选)
# 用于容器内 opencode 的模型认证(如 Anthropic / OpenAI / DeepSeek 等)。
# 也可不填,改用:docker exec -it astrbot opencode auth login 交互式登录。
OPENCODE_API_KEY=

# NapCat 容器运行 UID/GID(可选,建议与宿主机一致)
# 直接 export 后启动:export NAPCAT_UID=$(id -u) NAPCAT_GID=$(id -g) && docker compose up -d
NAPCAT_UID=1000
NAPCAT_GID=1000